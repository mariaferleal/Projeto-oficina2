# Copie este arquivo para .env e preencha os valores.
# Nunca envie o arquivo .env para o repositório.

# Servidor
PORT=3000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=troque-este-valor

# Login com Google (Client ID gerado no Google Cloud Console)
GOOGLE_CLIENT_ID=

# Interface
VITE_API_URL=http://localhost:3000
VITE_GOOGLE_CLIENT_ID=

# Banco de desenvolvimento
DB_USER=admin
DB_PASSWORD=senha_dev
DB_NAME=blocoBot_dev_db
DB_PORT=5432
# Dentro do Docker o host do banco é "postgres" e a porta é sempre 5432
DATABASE_URL=postgresql://admin:senha_dev@postgres:5432/blocoBot_dev_db

# Banco de testes (o docker-compose monta a DATABASE_URL do backend_test a partir destes valores)
DB_TEST_USER=admin
DB_TEST_PASSWORD=senha_test
DB_TEST_NAME=blocoBot_test_db
DB_TEST_PORT=5433
