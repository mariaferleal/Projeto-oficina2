# Copie este arquivo para .env e preencha os valores.
# Nunca envie o arquivo .env para o repositório.

# Servidor
PORT=3000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=troque-este-valor

# Login com Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Banco de dados (a escolha ainda está em aberto)
DATABASE_URL=

# Interface
VITE_API_URL=http://localhost:3000
VITE_GOOGLE_CLIENT_ID=

# Banco de Dev
DB_USER=admin
DB_PASSWORD=senha_dev
DB_NAME= blocoBot_dev_db
DB_PORT=5432
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@postgres:5432/blocoBot_dev_db

# Banco de Testes
DB_TEST_USER=admin
DB_TEST_PASSWORD=senha_test
DB_TEST_NAME=blocoBot_test_db
DB_TEST_PORT=5433
DATABASE_TEST_URL=postgresql://DB_TEST_USER:DB_TEST_PASSWORD@postgres_test:5433/blocoBot_test_db